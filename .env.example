# Copy to .env and fill in. Never commit .env.
# The backend reads ../.env itself in development; Docker Compose reads it in production.

# --- Database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
# Development only (the production compose file points the backend at its own postgres service)
DB_HOST=localhost
DB_PORT=5433

# --- Administrator created on first start (password: 12 characters minimum)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-with-a-long-password

# --- Secrets
# JWT signing key, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=
# Salt for IP hashing, at least 16 characters: openssl rand -hex 32
TRACKING_SALT=

# --- Web
# Public origins of the site, comma-separated (CORS). Behind Traefik the API sees plain HTTP, so list every
# address readers and the administrator use, e.g. https://portfolio-public,https://portfolio-admin
APP_ORIGIN=http://localhost:5173
# Secure flag on cookies; set to false only for plain-HTTP development outside localhost
COOKIE_SECURE=true
# Uploaded files directory (production: the /data/uploads volume)
UPLOAD_DIR=./data/uploads
# Proxies whose X-Forwarded-For is trusted (addresses or CIDR, comma-separated)
TRUSTED_PROXIES=127.0.0.1
# Ports published by Traefik (HTTP redirects to HTTPS)
HTTP_PORT=80
HTTPS_PORT=443
# Local domains (hosts file) and the public site address used by the administration's "Voir le site" link
PUBLIC_HOST=portfolio-public
ADMIN_HOST=portfolio-admin
PUBLIC_SITE_URL=https://portfolio-public
# Real public domains only: e-mail for Let's Encrypt certificates (empty = local certificates in traefik/certs)
ACME_EMAIL=
# Who may reach /admin and the admin API in production: "all", or addresses / CIDR, comma-separated
ADMIN_ALLOW_FROM=all

# --- Google sign-in ("Continuer avec Google"; empty = button hidden)
# Google Cloud console → APIs & Services → Credentials → OAuth client ID, type "Web application".
#   Authorised redirect URI: exactly GOOGLE_REDIRECT_URI below. Google only accepts localhost or a real public
#   domain (.com, .fr…): for the local "portfolio-admin" name, register https://localhost/api/auth/google/callback
#   and set GOOGLE_REDIRECT_URI to it; the browser then returns to ADMIN_SITE_URL by itself.
# Only the administrator's address (ADMIN_EMAIL) can sign in with Google; no account is ever created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost/api/auth/google/callback
# Address of the administration (where the browser lands after Google)
ADMIN_SITE_URL=https://portfolio-admin

# --- Media
# Largest video (MP4, WebM) in megabytes, and the matching Nginx upload limit (keep it a little higher)
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_BODY=110m

# --- Options
# Create the demo pages on the very first start
DEMO_CONTENT=true
# OpenAPI documentation at /swagger-ui.html (development only)
OPENAPI_ENABLED=false
